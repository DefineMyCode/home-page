// Determine which icons use fill vs stroke
const fillIcons = new Set(['github', 'bilibili', 'discord', 'douyin']);

function getIconPath(icon: string): string {
  return iconPaths[icon] || iconPaths['link'];
}

const isFill = fillIcons.has(link.icon);
const dialogId = isQR ? `qr-dialog-${index}` : undefined;
---

{isQR ? (
  <div>
    <button
      class="link-card animate-fade-up"
      style={`--delay: ${delay}; --brand-color: ${link.color || 'var(--color-accent)'}`}
      type="button"
      data-dialog={dialogId}
    >
      <svg
        class="link-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill={isFill ? 'currentColor' : 'none'}
        stroke={isFill ? 'none' : 'currentColor'}
        stroke-width={isFill ? '0' : '2'}
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d={getIconPath(link.icon)} />
      </svg>
      <span class="link-title">{link.title}</span>
    </button>

    <dialog id={dialogId}>
      <button class="dialog-close" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <p class="dialog-title">{link.title}</p>
      {link.qrImage && (
        <img class="dialog-image" src={link.qrImage} alt={`${link.title} QR Code`} />
      )}
    </dialog>
  </div>
) : (
  <a
    class="link-card animate-fade-up"
    href={link.url}
    target="_blank"
    rel="noopener noreferrer"
    style={`--delay: ${delay}; --brand-color: ${link.color || 'var(--color-accent)'}`}
  >
    <svg
      class="link-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill={isFill ? 'currentColor' : 'none'}
      stroke={isFill ? 'none' : 'currentColor'}
      stroke-width={isFill ? '0' : '2'}
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={getIconPath(link.icon)} />
    </svg>
    <span class="link-title">{link.title}</span>
    <svg class="link-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </a>
)}

<style>
  .link-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.875rem 1.25rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 1px 3px var(--color-shadow);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
    text-align: left;
  }

  .link-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px var(--color-shadow-hover);
    border-color: var(--brand-color, var(--color-accent));
  }

  .link-icon {
    flex-shrink: 0;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .link-card:hover .link-icon {
    color: var(--brand-color, var(--color-accent));
  }

  .link-title {
    flex: 1;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .link-arrow {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .link-card:hover .link-arrow {
    color: var(--brand-color, var(--color-accent));
    transform: translateX(2px);
  }
</style>
